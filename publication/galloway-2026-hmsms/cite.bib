@article{galloway2026topology,
title = {Model-informed joint material-structural optimization of hard-magnetic soft materials},
journal = {Journal of the Mechanics and Physics of Solids},
volume = {219},
pages = {106920},
year = {2027},
issn = {0022-5096},
doi = {https://doi.org/10.1016/j.jmps.2026.106920},
url = {https://www.sciencedirect.com/science/article/pii/S0022509626004205},
author = {Ian Galloway and Prashant K. Jha},
keywords = {Hard-magnetic soft materials, Topology optimization, Constitutive model selection, Structure–property relations, Magneto-mechanical coupling, Joint material–structural design},
abstract = {This work develops a model-informed framework for predictive analysis and optimal design of hard-magnetic soft materials (hMSMs). These materials undergo contact-free, field-driven deformation, making them attractive for soft robotics, adaptive structures, and bio-inspired systems. Accurate prediction requires effective structure–property relations, while optimal design requires simultaneous control of structural density, magnetic particle distribution, and remanent magnetization direction. To address these issues, this work makes two main contributions. First, classical rigid-inclusion relations, a Hill self-consistent relation, and constrained-kinematics models are placed into a unified effective shear-modulus framework for particle-filled elastomers. Six shear-modulus relations that depend on particle volume fraction, together with one default control relation, are combined with three strain-energy density functions to obtain 21 constitutive models. The results show that the strain-energy density form has a relatively small effect for the actuation problems considered, whereas the effective shear-modulus relation can significantly affect deformation when magnetic material overlaps with regions undergoing substantial deformation. Experimental stress–strain data are then used to select a representative shear-modulus relation, with the Mooney relation giving the lowest errors among the candidates for the dataset and metrics considered. Second, the selected constitutive model is incorporated into a joint material–structural optimization formulation with separate design fields for structural density, magnetic particle volume fraction, and remanent magnetization direction; the particle volume fraction field affects both effective stiffness and magnetic loading, while the applied magnetic field is prescribed. Rotational, translational, restorative, and three-dimensional morphing examples show that the framework handles different active design fields, objectives, and single- or multi-load-case formulations, producing non-intuitive hMSM designs with prescribed deformation responses. The framework is implemented in the open-source CEADpx/MatTO repository.}
}